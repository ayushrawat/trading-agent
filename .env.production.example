# Copy to .env on the VM and fill in.
# This file is read by docker-compose for both Caddy (DOMAIN) and the app.

# === Domain (no scheme, no path) ===
DOMAIN=trading-agent-ayush.duckdns.org

# === LLM ===
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# === Google OAuth + allowlist ===
AUTH_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
ALLOWED_EMAILS_RAW=you@gmail.com,friend@gmail.com
# Must match exactly what is registered in Google Cloud Console:
OAUTH_REDIRECT_URI=https://trading-agent-ayush.duckdns.org/auth/callback

# === DB + scheduler ===
DATABASE_URL=sqlite:////data/trading_agent.db
NEWS_INTERVAL_MIN=30
MARKET_INTERVAL_MIN=15
SIGNAL_INTERVAL_MIN=60
MARKET_OPEN_HHMM=0915
MARKET_CLOSE_HHMM=1530
