# Copy to .env and fill in.
#
# LLM — defaults to Google Gemini 2.5 Flash (free tier on AI Studio).
# Get a key at https://aistudio.google.com/apikey and paste below.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# Other providers (uncomment one set to switch):
#
# Groq (free tier, fast — get key at https://console.groq.com/keys)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
#
# DeepSeek (cheap, strong JSON — https://platform.deepseek.com/api_keys)
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
#
# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
#
# Local Ollama (no key needed, set anything)
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b

DATABASE_URL=sqlite:///./trading_agent.db

# Scheduler intervals (minutes)
NEWS_INTERVAL_MIN=30
MARKET_INTERVAL_MIN=15
SIGNAL_INTERVAL_MIN=60

# IST market hours gate (24h). Agents still run outside, but signal agent skips.
MARKET_OPEN_HHMM=0915
MARKET_CLOSE_HHMM=1530

# ----- Auth (Google OAuth + email allowlist) -----
# Leave AUTH_ENABLED=false for local dev with no auth. On Fly set to true
# and provide the rest via `fly secrets set`.
AUTH_ENABLED=false

# From https://console.cloud.google.com/apis/credentials — create an
# "OAuth client ID" of type "Web application". Add the redirect URI:
#   Local dev:  http://localhost:5173/auth/callback
#   Production: https://<your-fly-app>.fly.dev/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random ~50-char string used to sign the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Comma-separated list of emails allowed to sign in. Case-insensitive.
# Example: ALLOWED_EMAILS_RAW=you@gmail.com,friend@gmail.com
ALLOWED_EMAILS_RAW=

# Optional. If blank, the callback URL is derived from the incoming request.
# Set explicitly if you're behind a reverse proxy that rewrites the host.
OAUTH_REDIRECT_URI=
